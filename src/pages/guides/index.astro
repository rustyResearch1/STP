---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import CtaBand from '../../components/CtaBand.astro';
import { guides } from '../../data/guides';
import img1 from '../../assets/coast-strip.jpg';
---
<Base
  title="Therapy Guides | Therapy with Shloka"
  description="Short, practical guides to help you understand therapy: what sessions look like, what to expect, and how to choose a therapist."
>
  <section class="page-head">
    <div class="wrap">
      <p class="eyebrow">Guides</p>
      <h1>Guides</h1>
      <p class="lead">Practical, research-informed guides to help you navigate therapy and your mental health journey with more clarity.</p>
    </div>
  </section>

  <section class="section section--white section--line" style="padding-top:3.5rem">
    <div class="wrap">
      <ul class="cards">
        {guides.map((g) =>
          g.published ? (
            <li class="card">
              <div class="card__media"><Image src={img1} alt="" widths={[480, 800]} sizes="(max-width: 600px) 100vw, 33vw" quality={70} /></div>
              <div class="card__body">
                <p class="card__meta">Guide {g.number}</p>
                <h2 class="h3" style="font-size:1.3125rem;line-height:1.3;margin-bottom:.75rem"><a href={`/guides/${g.slug}`} style="color:inherit;text-decoration:none" class="card__link">{g.title}</a></h2>
                <p>{g.summary}</p>
                <span class="card__more" aria-hidden="true">Read guide →</span>
              </div>
            </li>
          ) : (
            <li class="card card--pending">
              <div class="card__body">
                <p class="card__meta">Guide {g.number} · In progress</p>
                <h2 style="font-size:1.3125rem;line-height:1.3;margin-bottom:.75rem">{g.title}</h2>
                <p>{g.summary}</p>
              </div>
            </li>
          )
        )}
      </ul>
    </div>
  </section>

  <CtaBand />
</Base>
<style>
  .card__link::after { content: ''; position: absolute; inset: 0; }
</style>
