---
import Base from '../layouts/Base.astro';
---
<Base title="Thank You | Therapy with Shloka" description="Your message has been sent." noindex>
  <section class="section" style="min-height:55vh;display:flex;align-items:center">
    <div class="wrap wrap--narrow">
      <p class="eyebrow">Message sent</p>
      <h1>Thank you.</h1>
      <hr class="rule" />
      <p class="lead">Your message has been sent. I'll get back to you within 24 hours.</p>
      <p>In the meantime, you may find this useful: <a href="/guides/what-therapy-looks-like">What therapy looks like</a>.</p>
    </div>
  </section>
</Base>
