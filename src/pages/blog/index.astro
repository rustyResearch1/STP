---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CtaBand from '../../components/CtaBand.astro';

const posts = (await getCollection('blog')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const fmt = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
---
<Base
  title="Writing on Identity, Immigration and Relationships | Shloka Iyer, LMFT"
  description="Essays by Shloka Iyer, LMFT on identity, immigration, relationships, and the inner lives we carry."
>
  <section class="page-head">
    <div class="wrap">
      <p class="eyebrow">Writing</p>
      <h1>Essays</h1>
      <p class="lead">Reflections on identity, immigration, relationships, and the inner lives we carry.</p>
    </div>
  </section>

  <section class="section section--white section--line" style="padding-top:3.5rem">
    <div class="wrap">
      <ul class="cards cards--two">
        {posts.map((post) => (
          <li class="card">
            <div class="card__media"><Image src={post.data.cover} alt="" widths={[480, 800]} sizes="(max-width: 600px) 100vw, 45vw" quality={70} /></div>
            <div class="card__body">
              <p class="card__meta"><time datetime={post.data.date.toISOString().slice(0, 10)}>{fmt(post.data.date)}</time></p>
              <h2 style="font-size:1.4375rem;line-height:1.3;margin-bottom:.75rem"><a class="card__link" href={`/blog/${post.id}`} style="color:inherit;text-decoration:none">{post.data.title}</a></h2>
              <p>{post.data.excerpt}</p>
              <span class="card__more" aria-hidden="true">Read more →</span>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <CtaBand />
</Base>
<style>
  .card__link::after { content: ''; position: absolute; inset: 0; }
</style>
