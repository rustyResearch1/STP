---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import CtaBand from '../components/CtaBand.astro';
import { guides } from '../data/guides';
import { site } from '../data/site';
import heroImg from '../assets/coast-hero.jpg';
import portrait from '../assets/shloka-portrait.jpg';
import guideImg from '../assets/still-life.jpg';

const posts = (await getCollection('blog')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 2);
const guide = guides[0];

const familiar = [
  "You're building a successful life but still feel disconnected from yourself.",
  'You feel caught between different cultures, expectations, or versions of home.',
  "You're navigating career success alongside burnout, stagnation, or uncertainty.",
  'You understand your patterns intellectually but still find yourself repeating them.',
  "You're finding it harder to build community or maintain meaningful relationships as an adult.",
  "You're questioning your direction, identity, or what feels meaningful at this stage of life.",
  'You tend to carry responsibilities quietly while appearing to have everything under control.',
  "You're looking for a space that values curiosity over judgment and exploration over quick fixes.",
];
---
<Base
  title="Therapy for First-Gen and Immigrant Adults in California | Shloka Iyer, LMFT"
  description="South Asian therapist Shloka Iyer, LMFT offers online therapy across California for immigrants, first-gen adults and people navigating identity, relationships and change."
>
  <section class="hero">
    <div class="hero__media">
      <Image src={heroImg} alt="" widths={[640, 960, 1400]} sizes="(max-width: 820px) 100vw, 66vw" loading="eager" fetchpriority="high" quality={70} />
    </div>
    <div class="wrap hero__inner">
      <div class="hero__text">
        <h1>Therapy for immigrants, first-generation adults, and individuals navigating identity, relationships &amp; life transitions</h1>
        <p class="display">Life doesn't always become difficult because something has gone wrong. <em>Sometimes it's because you've changed.</em></p>
        <hr class="rule" />
        <p class="hero__sub">Therapy offers a space to slow down, make sense of what's happening, and respond to life with greater intention rather than simply reacting to it.</p>
        <div class="hero__cta">
          <a class="btn" href="/contact">Book a Consultation</a>
          <span class="hero__note">Free 15-minute call · Online across California</span>
        </div>
      </div>
    </div>
  </section>

  <div class="trust">
    <div class="wrap">
      <ul>
        <li>{site.license}, California</li>
        <li>South Asian therapist in San Francisco</li>
        <li>In-network with Aetna and United Healthcare</li>
        <li><a href={site.psychologyToday} rel="noopener">Verified on Psychology Today</a></li>
      </ul>
    </div>
  </div>

  <section class="section">
    <div class="wrap">
      <div class="statement" data-reveal>
        <div class="sprig"><Icon name="leaf" /></div>
        <p>You may be navigating life between cultures, questioning where you belong, feeling disconnected from a version of yourself that once felt familiar, or carrying responsibilities that others don't always see. On paper, things may look stable, yet something still feels off.</p>
      </div>
    </div>
  </section>

  <section class="section section--cream section--line" aria-labelledby="familiar-heading">
    <div class="wrap focus">
      <div class="focus__head" data-reveal>
        <p class="eyebrow">Familiar experiences</p>
        <h2 id="familiar-heading">You might find yourself here if…</h2>
        <hr class="rule" />
        <p>You don't need to fit neatly into a diagnosis to benefit from therapy.</p>
      </div>
      <ul class="focus-list">
        {familiar.map((line) => <li>{line}</li>)}
      </ul>
    </div>
  </section>

  <section class="section section--white section--line">
    <div class="wrap split">
      <div class="split__media split__media--portrait arch" data-reveal>
        <Image src={portrait} alt="Shloka Iyer, LMFT, a South Asian therapist based in San Francisco" widths={[400, 640, 900]} sizes="(max-width: 820px) 22rem, 40vw" quality={75} />
      </div>
      <div class="prose" data-reveal style="--d:120ms">
        <p class="eyebrow">A little about me</p>
        <h2>I'm Shloka.</h2>
        <hr class="rule" />
        <p>I'm a Licensed Marriage and Family Therapist based in San Francisco, California.</p>
        <p>My interest in psychology grew through lived experiences, close relationships where mental health was present, and my own experience as an immigrant. Those experiences continue to shape how I think about identity, belonging, relationships, and the importance of understanding people within the context of their lives.</p>
        <p>Outside of therapy, you'll usually find me hiking, planning my next trip, or spending time by the ocean. I also have a cat named Oreo, who may occasionally make an appearance during telehealth sessions.</p>
        <p><a class="arrow-link" href="/about">Read more about my background and philosophy</a></p>
      </div>
    </div>
  </section>

  <section class="section section--line">
    <div class="wrap panels">
      <div class="panel" data-reveal>
        <Icon name="context" />
        <h2><a href="/who-i-work-with">Who I work with</a></h2>
        <p>While I work with adults from a variety of backgrounds, much of my practice has naturally evolved around people navigating questions of identity, belonging, relationships, and change.</p>
        <p>This often includes immigrants, first-generation adults, and individuals who find themselves balancing multiple expectations, adapting to different environments, or trying to understand who they are in this stage of life.</p>
        <span class="card__more" aria-hidden="true">Learn more →</span>
      </div>
      <div class="panel" data-reveal style="--d:120ms">
        <Icon name="chat" />
        <h2><a href="/approach">My approach</a></h2>
        <p>I believe therapy works best when it feels like a genuine therapeutic relationship rather than a one-sided process.</p>
        <p>My style is conversational, engaged, and, at times, direct. I value authenticity in the therapy room and don't aim to be a blank slate.</p>
        <span class="card__more" aria-hidden="true">Read more →</span>
      </div>
    </div>
  </section>

  <section class="section section--white section--line" aria-labelledby="writing-heading">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <div>
          <p class="eyebrow">Resources</p>
          <h2 id="writing-heading">Recent writing</h2>
          <p style="max-width:36rem;margin-top:1rem">I write about identity, relationships, culture, and modern life, particularly the experiences that often go unnamed but shape how we understand ourselves.</p>
        </div>
        <a class="arrow-link" href="/resources">Explore the resource library</a>
      </div>
      <ul class="cards">
        {posts.map((post, i) => (
          <li class="card" data-reveal style={`--d:${i * 100}ms`}>
            <div class="card__media">
              <Image src={post.data.cover} alt="" widths={[480, 800]} sizes="(max-width: 600px) 100vw, 33vw" quality={70} />
            </div>
            <div class="card__body">
              <p class="card__meta">Essay</p>
              <h3><a href={`/blog/${post.id}`}>{post.data.title}</a></h3>
              <p>{post.data.excerpt}</p>
              <span class="card__more" aria-hidden="true">Read more →</span>
            </div>
          </li>
        ))}
        <li class="card" data-reveal style="--d:200ms">
          <div class="card__media">
            <Image src={guideImg} alt="" widths={[480, 800]} sizes="(max-width: 600px) 100vw, 33vw" quality={70} />
          </div>
          <div class="card__body">
            <p class="card__meta">Guide {guide.number}</p>
            <h3><a href={`/guides/${guide.slug}`}>{guide.title}</a></h3>
            <p>{guide.summary}</p>
            <span class="card__more" aria-hidden="true">Read guide →</span>
          </div>
        </li>
      </ul>
    </div>
  </section>

  <section class="section section--line" aria-labelledby="answers-heading">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <div>
          <p class="eyebrow">Practical details</p>
          <h2 id="answers-heading">Frequently asked questions</h2>
        </div>
        <a class="arrow-link" href="/faq">View all FAQs</a>
      </div>
      <dl class="answers" data-reveal>
        <div>
          <dt>How long are sessions?</dt>
          <dd>50-minute virtual sessions conducted online across California.</dd>
        </div>
        <div>
          <dt>Do you accept insurance?</dt>
          <dd>I am in-network with Aetna and United Healthcare (Optum), including Oxford (Optum) and United Healthcare Medicare Advantage.</dd>
        </div>
        <div>
          <dt>What is your fee?</dt>
          <dd>My standard fee is {site.fee} per 50-minute session. A limited number of sliding-scale appointments are available.</dd>
        </div>
        <div>
          <dt>What does therapy with you look like?</dt>
          <dd>Therapy is conversational and adapted to your needs. The first session is more structured to help us understand your background and goals, while subsequent sessions become more exploratory and collaborative.</dd>
        </div>
      </dl>
    </div>
  </section>

  <CtaBand />
</Base>
