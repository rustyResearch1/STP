---
import '@fontsource/playfair-display/400.css';
import '@fontsource/playfair-display/400-italic.css';
import '@fontsource/playfair-display/500.css';
import '@fontsource-variable/inter';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';

interface Props {
  title: string;
  description: string;
  ogType?: 'website' | 'article' | 'profile';
  ogImage?: string;
  noindex?: boolean;
  schema?: Record<string, unknown>[];
}

const { title, description, ogType = 'website', ogImage = '/og-default.jpg', noindex = false, schema = [] } = Astro.props;
const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '').replace(/\/$/, '');
const canonical = new URL(path || '/', site.url).href;
const ogImageUrl = new URL(ogImage, site.url).href;

// Site-wide structured data: who Shloka is and what the practice offers.
const baseSchema = [
  {
    '@type': 'Person',
    '@id': `${site.url}/#person`,
    name: site.therapist,
    honorificSuffix: site.credential,
    jobTitle: site.jobTitle,
    description:
      'Licensed Marriage and Family Therapist offering culturally-informed online therapy for immigrants, first-generation adults and high-functioning adults across California.',
    url: `${site.url}/about`,
    image: `${site.url}/shloka-iyer-lmft.jpg`,
    sameAs: [site.psychologyToday],
    knowsAbout: ['Immigration and acculturation', 'First-generation identity', 'South Asian mental health', 'Anxiety', 'Burnout', 'Relationships', 'Life transitions'],
    hasCredential: {
      '@type': 'EducationalOccupationalCredential',
      credentialCategory: 'license',
      name: `California ${site.jobTitle} (${site.license})`,
    },
    worksFor: { '@id': `${site.url}/#practice` },
  },
  {
    '@type': 'ProfessionalService',
    '@id': `${site.url}/#practice`,
    name: site.name,
    description: 'Culturally-informed online therapy for adults across California.',
    url: site.url,
    image: `${site.url}/og-default.jpg`,
    founder: { '@id': `${site.url}/#person` },
    areaServed: { '@type': 'State', name: 'California' },
    address: { '@type': 'PostalAddress', addressLocality: site.city, addressRegion: 'CA', addressCountry: 'US' },
    availableLanguage: ['English'],
    priceRange: `${site.fee} per session`,
    paymentAccepted: ['Aetna', 'United Healthcare', 'Oxford', 'Self-pay'],
    serviceType: ['Individual therapy', 'Online therapy', 'Anxiety therapy', 'Therapy for immigrants and first-generation adults'],
  },
  {
    '@type': 'WebSite',
    '@id': `${site.url}/#website`,
    url: site.url,
    name: site.name,
    publisher: { '@id': `${site.url}/#practice` },
  },
];
const jsonLd = JSON.stringify({ '@context': 'https://schema.org', '@graph': [...baseSchema, ...schema] });
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="author" content={`${site.therapist}, ${site.credential}`} />
    <meta name="theme-color" content="#faf8f4" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={jsonLd} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
