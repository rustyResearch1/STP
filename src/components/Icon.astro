---
// Thin line icons in the style of the brand boards. Decorative: hidden from screen readers.
interface Props { name: 'leaf' | 'wave' | 'sun' | 'compass' | 'chat' | 'heart' | 'context' | 'book' }
const { name } = Astro.props;
---
<svg viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.15" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {name === 'leaf' && (
    <g>
      <path d="M13 35c2-8 6-16 14-27" />
      <path d="M17.5 24.5c-4.6.2-7.6-1.8-9-5.5 4.3-.8 7.6.8 9 5.5z" />
      <path d="M20.5 18.5c-3.8-.8-5.8-3.3-6-7 3.9.3 6.2 2.6 6 7z" />
      <path d="M19.5 21c3.2-3.4 6.8-4.3 10.5-2.8-1.8 3.8-5.3 4.9-10.5 2.8z" />
      <path d="M24 13.5c1.4-3.6 4-5.3 7.5-5.2-.3 3.8-2.8 5.6-7.5 5.2z" />
    </g>
  )}
  {name === 'wave' && (
    <g>
      <path d="M4 23c4.5 0 7.5-2 9.5-5.5 2.2-3.9 5.8-5.7 9.5-4.7 3 .8 4.5 3.6 3.4 6-.9 1.9-3.3 2.3-4.6.9" />
      <path d="M22 23c3.5 0 6.5-.8 9-2.5 1.8 1.6 3.5 2.5 5 2.5" />
      <path d="M4 28c3 0 5-1.2 7-1.2s4 1.2 7 1.2 5-1.2 7-1.2 4 1.2 7 1.2c1.5 0 2.8-.3 4-.8" />
      <path d="M8 32.5c2.5 0 4.2-1 6-1s3.5 1 6 1 4.2-1 6-1 3.5 1 6 1" />
    </g>
  )}
  {name === 'sun' && (
    <g>
      <circle cx="20" cy="20" r="7" />
      <path d="M20 5v4M20 31v4M5 20h4M31 20h4M9.4 9.4l2.8 2.8M27.8 27.8l2.8 2.8M30.6 9.4l-2.8 2.8M12.2 27.8l-2.8 2.8" />
      <path d="M13.2 6.3l.9 2M25.9 31.7l.9 2M6.3 26.8l2-.9M31.7 14.1l2-.9M6.3 13.2l2 .9M31.7 25.9l2 .9M26.8 6.3l-.9 2M14.1 31.7l-.9 2" />
    </g>
  )}
  {name === 'compass' && (
    <g>
      <circle cx="20" cy="21" r="13" />
      <path d="M17.5 5h5M20 5v3" />
      <path d="M25.5 15.5l-3.3 7.7-7.7 3.3 3.3-7.7 7.7-3.3z" />
      <circle cx="20" cy="21" r=".8" />
    </g>
  )}
  {name === 'chat' && (
    <g>
      <path d="M6 9.5h17a3 3 0 0 1 3 3v8a3 3 0 0 1-3 3h-9l-5 4.5v-4.5H6a3 3 0 0 1-3-3v-8a3 3 0 0 1 3-3z" />
      <path d="M29 15h4a3 3 0 0 1 3 3v7a3 3 0 0 1-3 3h-1v4l-4.5-4H22" />
      <path d="M10 16.5h.01M14.5 16.5h.01M19 16.5h.01" stroke-width="1.8" />
    </g>
  )}
  {name === 'heart' && (
    <g>
      <path d="M20 17.5c-1.5-3-6-2.8-6 .8 0 2.7 3 4.7 6 7.2 3-2.5 6-4.5 6-7.2 0-3.6-4.5-3.8-6-.8z" />
      <path d="M8 30c2.5-1.5 5-1.8 7.5-.8l5 2c2 .8 4 .6 6-.5l7-4" />
      <path d="M20 6v3M11 9l1.8 2.4M29 9l-1.8 2.4" />
    </g>
  )}
  {name === 'context' && (
    <g>
      <circle cx="20" cy="20" r="14" />
      <circle cx="20" cy="20" r="6.5" />
      <path d="M20 6v7.5M20 26.5V34M6 20h7.5M26.5 20H34" />
    </g>
  )}
  {name === 'book' && (
    <g>
      <path d="M20 11c-3-2-7.5-2.8-13-2.5v20c5.5-.3 10 .5 13 2.5 3-2 7.5-2.8 13-2.5v-20c-5.5-.3-10 .5-13 2.5z" />
      <path d="M20 11v20" />
    </g>
  )}
</svg>
