---
import Logo from './Logo.astro';
import { nav } from '../data/site';
const path = Astro.url.pathname.slice(import.meta.env.BASE_URL.replace(/\/$/, '').length).replace(/\.html$/, '').replace(/\/$/, '') || '/';
const isCurrent = (href: string) => path === href || path.startsWith(href + '/');
---
<header class="site-header">
  <div class="wrap site-header__inner">
    <Logo />
    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
      <span class="sr-only">Menu</span>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
    </button>
    <nav class="site-nav" id="site-nav" aria-label="Main">
      <ul>
        {nav.map((item) => (
          <li><a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a></li>
        ))}
      </ul>
      <a class="btn" href="/contact">Book a Consultation</a>
    </nav>
  </div>
</header>
<script is:inline>
  (function () {
    var btn = document.querySelector('.nav-toggle');
    var nav = document.getElementById('site-nav');
    if (!btn || !nav) return;
    btn.addEventListener('click', function () {
      var open = nav.classList.toggle('is-open');
      btn.setAttribute('aria-expanded', String(open));
    });
  })();
</script>
